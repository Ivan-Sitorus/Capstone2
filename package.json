{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.22.1"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js *.config.js",
        "lint:fix": "eslint resources/js *.config.js --fix",
        "format": "prettier --write \"resources/js/**/*.{js,jsx,css,json}\" \"*.config.js\" package.json components.json",
        "format:check": "prettier --check \"resources/js/**/*.{js,jsx,css,json}\" \"*.config.js\" package.json components.json"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^5.1.4",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@base-ui/react": "^1.4.1",
        "@inertiajs/react": "^3.7.1",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.575.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "tailwind-merge": "^3.6.0",
        "ziggy-js": "^2.6.2",
        "zustand": "^5.0.11"
    }
}
