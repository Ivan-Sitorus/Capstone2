@startuml
|Admin|
start
:Membuka daftar bahan baku;
:Memilih bahan baku;
:Mengklik "Kelola Batch";
:Mengklik "Tambah Batch";
:Mengisi form (jumlah, tanggal, harga);
:Mengklik "Simpan";
|Sistem|
:Menerima input dari form;
:Validasi data;
if (Jumlah positif?\nTanggal valid?) then (ya)
  |Database|
  :INSERT ke tabel ingredient_batches;
  :Mengembalikan response sukses;
  |Sistem|
  :Mengirim notifikasi sukses;
  |Admin|
  :Menampilkan notifikasi;
  :Batch baru muncul di daftar;
else (tidak)
  |Sistem|
  :Menampilkan pesan error;
  |Admin|
  :Melihat pesan error;
  :Memperbaiki input;
  :Mengklik "Simpan" kembali;
  -[hidden]-> Sistem
endif
stop
@enduml
