%%{init: {"flowchart": {"nodeSpacing": 15, "rankSpacing": 20, "padding": 5}}}%%
graph TB
    subgraph Transaction["Sistem Transaksi"]
        direction TB
        ADMIN["Admin Panel (Filament)"]
        KASIR["Kasir Pages (Inertia.js + React)"]
        PESANAN["CashierPesananBaruController"]
        ORDER["CashierOrderController"]
    end

    subgraph Inventory["Sistem Inventori"]
        direction TB
        subgraph Service["Lapisan Service (Business Logic)"]
            INV["InventoryService\n(FEFO/FIFO Engine)"]
            RECON["StockReconciliationService\n(Adjustment Logic)"]
        end

        subgraph Model["Lapisan Model (Data Access)"]
            direction LR
            MENU["Menu"]
            INGREDIENT["Ingredient"]
            BATCH["IngredientBatch"]
            MOVEMENT["StockMovement"]
            ADJUST["StockAdjustment"]
        end

        subgraph Database["Database"]
            DB[("PostgreSQL")]
        end
    end

    ADMIN -->|"CRUD"| MENU
    ADMIN -->|"CRUD"| INGREDIENT
    ADMIN -->|"CRUD"| BATCH
    KASIR -->|"Order request"| PESANAN
    PESANAN -->|"processSaleForOrder()"| INV
    ORDER -->|"confirmCash / confirmQris"| INV
    INV -->|"deductIngredientStock()\nFEFO/FIFO"| BATCH
    INV -->|"record movement"| MOVEMENT
    RECON -->|"createManualAdjustment()"| ADJUST
    RECON -->|"reversal"| MOVEMENT
    MENU --> DB
    INGREDIENT --> DB
    BATCH --> DB
    MOVEMENT --> DB
    ADJUST --> DB
