@startuml
|Admin|
start
:Membuka halaman daftar bahan baku;
:Mengklik tombol "Tambah Bahan Baku";
:Mengisi form (nama, unit, mode batch FEFO/FIFO);
:Mengklik tombol "Simpan";
|Sistem|
:Menerima input dari form;
:Validasi data (nama tidak kosong, unit valid, mode batch valid);
if (Data valid?) then (ya)
  :Menyimpan data ke database;
  |Database|
  :INSERT ke tabel ingredients;
  :Mengembalikan response sukses;
  |Sistem|
  :Mengirim notifikasi sukses;
  |Admin|
  :Menampilkan notifikasi;
  :Data bahan baku baru muncul di tabel;
  stop
else (tidak)
  |Admin|
  :Menampilkan pesan error;
  :Memperbaiki input;
  -[hidden]-> Sistem
endif
@enduml
