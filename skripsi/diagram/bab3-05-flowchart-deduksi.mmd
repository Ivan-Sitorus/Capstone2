%%{init: {"flowchart": {"nodeSpacing": 20, "rankSpacing": 25, "padding": 10}}}%%
flowchart TB
    START([Mulai]) --> CEK["Cek idempotensi:
    StockMovement untuk
    order ini sudah ada?"]
    CEK --> SUDAH{Sudah\ndiproses?}
    SUDAH -->|Ya| SKIP(["Selesai:
    dilewati"])
    SUDAH -->|Belum| ITEM{Item\nkosong?}
    ITEM -->|Ya| SKIP
    ITEM -->|Tidak| LOAD["Muat data menu
    dan bahan baku resep"]

    LOAD --> PROSES_ITEM["Ambil item
    berikutnya"]
    PROSES_ITEM --> ADA_ITEM{Item\nberikutnya?}
    ADA_ITEM -->|Tidak| KOMIT(["Selesai:
    stok berhasil dikurangi"])

    ADA_ITEM -->|Ya| RESEP{Resep\ntersedia?}
    RESEP -->|Tidak| PROSES_ITEM
    RESEP -->|Ya| BAHAN["Ambil bahan baku
    berikutnya"]

    BAHAN --> ADA_BAHAN{Bahan baku\nberikutnya?}
    ADA_BAHAN -->|Tidak| PROSES_ITEM
    ADA_BAHAN -->|Ya|     HITUNG["Hitung kebutuhan:
    quantity_used
    × jumlah pesanan"]

    HITUNG --> MODE{Mode batch?}
    MODE -->|FIFO| URUT_FIFO["Urut received_at ASC
    (paling lama
    duluan)"]
    MODE -->|FEFO| URUT_FEFO["Urut expiry_date ASC
    (paling cepat
    kedaluwarsa duluan)"]

    URUT_FIFO --> SISA["Sisa kebutuhan:
    requiredQuantity"]
    URUT_FEFO --> SISA
    SISA --> AMBIL_BATCH["Ambil batch
    berikutnya"]
    AMBIL_BATCH --> DEDUKSI["Kurangi:
    min(qty_batch,
    sisa)"]
    DEDUKSI --> CATAT["Catat pergerakan
    stok"]
    CATAT --> SISAKURANG{"Sisa kebutuhan\nmasih ada?"}
    SISAKURANG -->|Ya| AMBIL_BATCH
    SISAKURANG -->|Tidak| ADA_BAHAN

    classDef start fill:#1a1a2e,color:#fff;
    classDef endNode fill:#1a1a2e,color:#fff;
    classDef decision fill:#f0f0f0,stroke:#333;
    class START,SKIP,KOMIT start;
    class SUDAH,ITEM,ADA_ITEM,RESEP,MODE,SISAKURANG decision;
