# Referensi environment variables untuk deploy Vercel (set di Vercel Dashboard).
# Jangan commit nilai asli — ini template saja.

APP_NAME="W9 Cafe POS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<project>.vercel.app
LOG_CHANNEL=stderr

# Generate dengan: php artisan key:generate --show
APP_KEY=

# Neon (PostgreSQL serverless)
DB_CONNECTION=pgsql
DB_HOST=<neon-host>
DB_PORT=5432
DB_DATABASE=<neon-database>
DB_USERNAME=<neon-user>
DB_PASSWORD=<neon-password>

# DIISI OTOMATIS via service binding (jangan set manual):
# DATAMINING_URL=<url-internal-service-mining>

# Stateless di Vercel:
SESSION_DRIVER=database
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Storage upload (menu image) -> Vercel Blob (S3-compatible):
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=<blob-access-key>
AWS_SECRET_ACCESS_KEY=<blob-secret-key>
AWS_DEFAULT_REGION=auto
AWS_BUCKET=<blob-bucket>
AWS_ENDPOINT=https://<blob-s3-endpoint>
