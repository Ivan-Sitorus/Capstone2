APP_NAME=POSMine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pos_cafe
DB_USERNAME=postgres
DB_PASSWORD=

FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DATAMINING_URL=http://datamining:8001

# -- Seeder (data contoh) ---------------------------------------------
# Rentang data: kosongkan SEED_END_DATE untuk memakai "hari ini".
SEED_START_DATE=2025-01-01
SEED_END_DATE=
# Rata-rata order per hari (bervariasi: weekend & musiman).
SEED_ORDERS_PER_DAY=100
SEED_WEEKEND_MULTIPLIER=1.4
SEED_DAILY_JITTER=0.15
# Komposisi item per order.
SEED_ITEMS_MIN=2
SEED_ITEMS_MAX=6
SEED_QTY_MIN=1
SEED_QTY_MAX=3
# Porsi order berdiskon mahasiswa (0-1).
SEED_STUDENT_RATE=0.25
# Ukuran batch proses seed.
SEED_CHUNK_DAYS=7
SEED_INSERT_CHUNK=1000
